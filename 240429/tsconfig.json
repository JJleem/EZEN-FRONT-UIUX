{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "outDir": "dist",
    "strict": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "sourceMap": true,
    "downlevelIteration": true,
    "noImplicitAny": false,
    "allowJs": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["src"] //src 폴더안에있는 데이터만 컴파일링해라
}
